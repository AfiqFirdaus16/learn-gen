// Ini adalah generator yang akan menerjemahkan skema Anda menjadi kode JavaScript
generator client {
  provider = "prisma-client-js"
}

// Konfigurasi koneksi ke Supabase (URL kini diatur lewat prisma.config.ts)
datasource db {
  provider = "postgresql"
}

// ==========================================
// RANCANGAN TABEL DATABASE
// ==========================================

model Admin {
  // Primary Key: ID unik yang dibuat otomatis
  id        Int      @id @default(autoincrement())
  
  // Data Profil Admin
  nama      String
  email     String   @unique 
  password  String   
  
  // Relasi
  videos    Video[]
  
  // Pelacakan Waktu (Audit Trail)
  createdAt DateTime @default(now()) 
  updatedAt DateTime @updatedAt      
}

model Video {
  // Primary Key
  id        Int      @id @default(autoincrement())
  
  // Foreign Key
  adminId   Int
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  
  // Data Pembelajaran
  learnerName      String
  topic            String
  learningStyle    String  // visual, auditory, kinesthetic, dll
  persona          String  // guru ramah, mentor serius, dll
  duration         Int     // dalam menit
  accentType       String  // British, American, dll
  
  // Generated Data
  generatedPrompt  String?  @db.Text
  heygenVideoId    String?  @unique
  videoUrl         String?
  
  // Status
  status           String   @default("pending") // pending, processing, completed, failed
  
  // Metadata
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  completedAt      DateTime?
}
