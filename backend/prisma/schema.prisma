// Ini adalah generator yang akan menerjemahkan skema Anda menjadi kode JavaScript
generator client {
  provider = "prisma-client-js"
}

// Konfigurasi koneksi ke Supabase (URL kini diatur lewat prisma.config.ts)
datasource db {
  provider = "postgresql"
}

// Definisikan Enum untuk Peran Pengguna (Lebih aman dari sekadar String)
enum Role {
  ADMIN
  DOSEN
  MAHASISWA
}

// ==========================================
// RANCANGAN TABEL DATABASE
// ==========================================

// Model Admin diubah menjadi User karena mencakup banyak peran
model User {
  // Primary Key: ID unik yang dibuat otomatis
  id        Int      @id @default(autoincrement())
  
  // Data Profil Pengguna
  nama      String
  email     String   @unique 
  password  String   
  role      Role     @default(MAHASISWA) 
  
  // Relasi
  videos    Video[]
  materi    Materi[] // Relasi tambahan untuk Dosen/Admin membuat materi
  tests     Test[]
  personas  Persona[]
  
  // Pelacakan Waktu (Audit Trail)
  createdAt DateTime @default(now()) 
  updatedAt DateTime @updatedAt      
}

model Persona {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  learningStyle String
  avatarId      String
  avatarName    String
  voiceId       String
  voiceName     String
  level         String
  tone          String
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Video {
  // Primary Key
  id              Int      @id @default(autoincrement())
  
  // Foreign Key (Diperbarui mengarah ke User, bukan Admin)
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Data Pembelajaran
  learnerName     String
  topic           String
  learningStyle   String  // visual, auditory, kinesthetic, dll
  persona         String  // guru ramah, mentor serius, dll
  duration        Int     // dalam menit
  durationSeconds Int?    // durasi target presisi dalam detik untuk video baru
  accentType      String  // British, American, dll
  
  // Generated Data
  script          String?  @db.Text
  generatedPrompt String?  @db.Text
  elevenlabsVideoId   String?  @unique
  videoUrl        String?
  
  // Status
  status          String   @default("pending") // pending, processing, completed, failed
  
  // Metadata
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  completedAt     DateTime?
}

// ==========================================
// TABEL TAMBAHAN BERDASARKAN PEMBARUAN UI
// ==========================================

model Materi {
  id        Int      @id @default(autoincrement())
  judul     String
  deskripsi String?
  
  // Relasi ke pembuat (Dosen/Admin)
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Test {
  id        Int      @id @default(autoincrement())
  judul     String
  status    String   @default("DRAFT") // DRAFT atau DIBAGIKAN
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Kelas {
  id        Int      @id @default(autoincrement())
  namaKelas String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}